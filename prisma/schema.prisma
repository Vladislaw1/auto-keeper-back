generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
  GAS
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum WorkCategory {
  ENGINE
  TRANSMISSION
  BRAKES
  SUSPENSION
  STEERING
  ELECTRICAL
  COOLING
  FUEL_SYSTEM
  EXHAUST
  TIRES
  BODY
  INTERIOR
  AC_CLIMATE
  DIAGNOSTICS
  OTHER
}

model Car {
  id String @id @default(uuid())

  brand        String
  model        String
  year         Int
  color        String?
  mileage      Int           @default(0)
  fuelType     FuelType
  transmission Transmission?
  engineCode   String?
  engineVolume Float
  vin          String?       @unique
  carNumber    String        @unique

  owner   Owner      @relation(fields: [ownerId], references: [id])
  ownerId String     @map("owner_id")
  photos  CarPhoto[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  serviceVisits ServiceVisit[]

  @@index([ownerId])
  @@map("cars")
}

model CarPhoto {
  id       String  @id @default(uuid())
  url      String
  publicId String
  isMain   Boolean @default(false)
  car      Car     @relation(fields: [carId], references: [id], onDelete: Cascade)
  carId    String  @map("car_id")

  @@index([carId])
  @@map("car_photos")
}

model Owner {
  id String @id @default(uuid())

  first_name String
  last_name  String
  cars       Car[]

  @@map("owners")
}

model ServiceVisit {
  id        String        @id @default(uuid())
  car       Car           @relation(fields: [carId], references: [id])
  carId     String
  date      DateTime
  mileage   Int
  totalCost Decimal?
  notes     String?
  items     ServiceItem[]
  createAt  DateTime      @default(now())
}

model ServiceItem {
  id         String       @id @default(uuid())
  visit      ServiceVisit @relation(fields: [visitId], references: [id])
  visitId    String
  workType   WorkType     @relation(fields: [workTypeId], references: [id])
  workTypeId String
  price      Decimal?
  note       String?

  @@unique([visitId, workTypeId]) // щоб не дублювати один тип робіт в одному візиті
}

model WorkType {
  id       String        @id @default(uuid())
  name     String        @unique
  category WorkCategory
  isActive Boolean       @default(true)
  items    ServiceItem[]
}

model CarBrand {
  id     String     @id @default(uuid())
  name   String     @unique
  models CarModel[]

  @@map("car_brands")
}

model CarModel {
  id      String   @id @default(uuid())
  name    String
  brand   CarBrand @relation(fields: [brandId], references: [id])
  brandId String   @map("brand_id")

  @@unique([brandId, name])
  @@index([brandId])
  @@map("car_models")
}

enum PlaceCategory {
  CAR_REPAIR
  TYRES
  CAR_WASH
  CAR_PARTS
}

model Place {
  id          String                            @id
  category    PlaceCategory
  lat         Float
  lon         Float
  name        String?
  phone       String?
  hours       String?
  website     String?
  address     String?
  tags        Json?
  ratingAvg   Float                             @default(0)
  ratingCount Int                               @default(0)
  location    Unsupported("geography(Point,4326)")?
  reviews     Review[]

  @@index([category])
  @@index([lat, lon])
}

model Review {
  id        String   @id @default(cuid())
  placeId   String
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  userId    String
  rating    Int
  text      String?
  createdAt DateTime @default(now())

  @@unique([placeId, userId])
  @@index([placeId])
}
